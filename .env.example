# ==============================================================================
# CAREGRID: Rural Healthcare Access & Care Coordination Platform
# Environment Variable Template (SIH26133 - Government of Maharashtra)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend & Client Application (Next.js / PWA)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=mr
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Backend & Database Access (Server-side Only)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AI Triage & Clinical Decision Assist Microservice (FastAPI)
# ------------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
AI_SERVICE_API_KEY=your-internal-microservice-secret-token

# ------------------------------------------------------------------------------
# 4. Teleconsultation & Notifications
# ------------------------------------------------------------------------------
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=MAHGOV
NEXT_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
